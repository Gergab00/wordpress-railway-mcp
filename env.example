# Railway service references for a MariaDB service named "MariaDB".
# If your database service has another name, replace "MariaDB" below.
WORDPRESS_DB_HOST=${{MariaDB.MYSQLHOST}}:${{MariaDB.MYSQLPORT}}
WORDPRESS_DB_NAME=${{MariaDB.MYSQLDATABASE}}
WORDPRESS_DB_USER=${{MariaDB.MYSQLUSER}}
WORDPRESS_DB_PASSWORD=${{MariaDB.MYSQLPASSWORD}}

# WordPress secret keys and salts.
# Generate fresh values at: https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=change-me
WORDPRESS_SECURE_AUTH_KEY=change-me
WORDPRESS_LOGGED_IN_KEY=change-me
WORDPRESS_NONCE_KEY=change-me
WORDPRESS_AUTH_SALT=change-me
WORDPRESS_SECURE_AUTH_SALT=change-me
WORDPRESS_LOGGED_IN_SALT=change-me
WORDPRESS_NONCE_SALT=change-me

# Optional WordPress config extras injected into wp-config.php by the official image.
WORDPRESS_CONFIG_EXTRA=

# Runtime paths.
WORDPRESS_PATH=/var/www/html

# Automated first install. Set to false if you want to use the WordPress web installer.
WP_AUTO_INSTALL=true
WP_SITE_URL=https://your-domain.example.com
WP_SITE_TITLE=WordPress Railway MCP
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-strong-password
WP_ADMIN_EMAIL=admin@example.com

# WordPress bootstrap options.
WP_ACTIVATE_STOREFRONT=true
WP_PERMALINK_STRUCTURE=/%postname%/

# WordPress MCP Adapter.
MCP_ADAPTER_VERSION=v0.5.0
MCP_ADAPTER_ZIP_URL=

# Optional custom plugins/themes from Git repositories.
# Comma-separated. Branches can be specified with #branch-name.
# Example: https://github.com/org/plugin.git#main,https://github.com/org/other-plugin.git
WP_CUSTOM_PLUGIN_REPOS=
WP_CUSTOM_THEME_REPOS=
WP_ACTIVATE_CUSTOM_PLUGINS=true
WP_ACTIVATE_CUSTOM_THEME=
WP_FORCE_UPDATE_CUSTOM_CODE=false
