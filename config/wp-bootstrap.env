# Non-secret WordPress bootstrap defaults loaded automatically by docker/wp-bootstrap.sh.
# Railway service variables with the same names take precedence.

WP_ACTIVATE_STOREFRONT=true
WP_THEME_SLUGS=
WP_PERMALINK_STRUCTURE=/%postname%/

MCP_ADAPTER_VERSION=v0.5.0
MCP_ADAPTER_ZIP_URL=

WP_CUSTOM_PLUGIN_REPOS=
WP_CUSTOM_THEME_REPOS=
WP_ACTIVATE_CUSTOM_PLUGINS=true
WP_ACTIVATE_CUSTOM_THEME=
WP_FORCE_UPDATE_CUSTOM_CODE=false
